{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(sudo*)",
      "Bash(rtk sudo*)",
      "Bash(chmod 777*)",
      "Bash(rtk chmod 777*)",
      "Bash(ssh*)",
      "Bash(rtk ssh*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(rtk tofu apply*)",
      "Bash(rtk tofu destroy*)",
      "Bash(gh repo delete*)",
      "Bash(rtk gh repo delete*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)"
    ],
    "ask": [],
    "allow": [
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git push origin --delete *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view *)",
      "Bash(gh api repos/*)",
      "Bash(gh api orgs/*)",
      "Bash(gh api user*)",
      "Bash(gh api graphql *)",
      "Bash(gh api --paginate *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk-proxy-hook.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/aws-guard-hook.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive-guard-hook.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/config-protection-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/writing-style-hook.sh\""
          },
          {
            "type": "command",
            "command": "/bin/bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/repo-structure-hook.sh\""
          }
        ]
      }
    ]
  }
}
